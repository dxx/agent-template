# 生产环境配置

APP_HOST=127.0.0.1
APP_PORT=8000

LOG_LEVEL=info
LOG_HANDLERS=["file"]
LOG_FORMAT_TYPE=json
LOG_FILE=logs/app.log

# CORS 允许的 origins
# 注意：CORS_ALLOW_CREDENTIALS=true 时，CORS_ALLOW_ORIGINS 不能包含 *
CORS_ALLOW_ORIGINS=["*"]
# 是否允许携带凭证
CORS_ALLOW_CREDENTIALS=false

# 为空禁用 openapi swagger
OPENAPI_URL=""

OPENAI_PROVIDER=bailian
OPENAI_BASE_URL=
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7

# Postgres memory 连接
POSTGRES_MEMORY_CONN_STR=postgresql://用户名:密码@IP:PORT/数据库名
